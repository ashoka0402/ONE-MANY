# Run commands from apps/api. Copy this file to .env for local overrides.
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
# Optional in Stage 0: health is liveness and does not connect to PostgreSQL.
# Match POSTGRES_PASSWORD in the root .env; never commit real credentials.
DATABASE_URL=postgresql+psycopg://one_many:replace-with-local-password@localhost:5432/one_many
