# Copy to apps/api/.env and update the placeholder values locally.
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://one_many:replace-with-local-password@localhost:5432/one_many
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-this-placeholder-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=60

# Real model extraction; leave unset to receive a transparent 503 (no fake AI responses).
# GEMINI_API_KEY=replace-with-your-own-server-side-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=12
MATCH_CANDIDATE_LIMIT=300

# Real Channel3 sponsor API credentials; keep only on backend.
# CHANNEL3_API_KEY=your_channel3_developer_key
CHANNEL3_COUNTRY=US
CHANNEL3_CURRENCY=USD
CHANNEL3_TIMEOUT_SECONDS=12
MAX_PROPOSAL_PARTICIPANTS=8
